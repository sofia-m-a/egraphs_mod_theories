	keywords = {conjunctive regular path queries, knowledge graphs, multi-way joins},
	file = {Full Text PDF:/home/pree/Zotero/storage/MRLH27UQ/Karalis et al. - 2024 - Efficient Evaluation of Conjunctive Regular Path Queries Using Multi-way Joins.pdf:application/pdf},
